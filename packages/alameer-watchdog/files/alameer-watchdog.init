#!/bin/sh /etc/rc.common
# ALAMEER SOFTWARE watchdog service
START=96
USE_PROCD=1

start_service() {
	[ "$(uci -q get alameer.watchdog.enabled)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/alameer-watchdog
	procd_set_param respawn 3600 10 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger alameer
}
