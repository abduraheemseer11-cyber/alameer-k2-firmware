#!/bin/sh
. /etc/al-makhadhi/defaults.conf

uci set system.@system[0].hostname="$FW_HOSTNAME"
uci set system.@system[0].timezone="$TIMEZONE"
uci commit system

uci set network.lan.ipaddr="$LAN_IP"
uci set network.lan.netmask="$LAN_NETMASK"
uci -q delete network.lan.ip6assign
uci -q delete network.globals.ula_prefix
uci -q delete network.wan6
uci commit network

[ -s /etc/config/wireless ] || wifi config
for r in $(uci show wireless | sed -n 's/^wireless\.\(radio[0-9]*\)=wifi-device$/\1/p'); do
  band="$(uci -q get wireless.$r.band)$(uci -q get wireless.$r.hwmode)"
  case "$band" in
    *2g*|*11g*) SSID="$SSID_2G"; CH="$CHANNEL_2G"; HT=HT20 ;;
    *)          SSID="$SSID_5G"; CH="$CHANNEL_5G"; HT=VHT80 ;;
  esac
  uci set wireless.$r.disabled='0'
  uci set wireless.$r.country="$COUNTRY"
  uci set wireless.$r.channel="$CH"
  uci set wireless.$r.htmode="$HT"
  I="default_$r"
  uci -q get wireless.$I >/dev/null || { uci set wireless.$I='wifi-iface'; uci set wireless.$I.device="$r"; uci set wireless.$I.network='lan'; uci set wireless.$I.mode='ap'; }
  uci set wireless.$I.ssid="$SSID"
  if [ -n "$WIFI_KEY" ] && [ ${#WIFI_KEY} -ge 8 ]; then
    uci set wireless.$I.encryption='psk2+ccmp'; uci set wireless.$I.key="$WIFI_KEY"
  else
    uci set wireless.$I.encryption='none'; uci -q delete wireless.$I.key
  fi
done
uci commit wireless

[ "${TTL_VALUE:-0}" -gt 0 ] 2>/dev/null && /usr/bin/al-ttl on "$TTL_VALUE"

[ -f /etc/openwrt_release ] && sed -i \
  -e "s|^DISTRIB_ID=.*|DISTRIB_ID='Al-Makhadhi'|" \
  -e "s|^DISTRIB_DESCRIPTION=.*|DISTRIB_DESCRIPTION='$FIRMWARE_TITLE'|" /etc/openwrt_release
[ -f /etc/os-release ] && sed -i \
  -e "s|^NAME=.*|NAME=\"Al-Makhadhi\"|" \
  -e "s|^PRETTY_NAME=.*|PRETTY_NAME=\"$FIRMWARE_TITLE\"|" /etc/os-release

CSS=/www/luci-static/bootstrap/cascade.css
[ -f $CSS ] && ! grep -q 'AL-MAKHADHI-BRAND' $CSS && cat /usr/share/al-makhadhi/brand.css >> $CSS

for s in odhcpd; do [ -x /etc/init.d/$s ] && /etc/init.d/$s disable; done
exit 0
