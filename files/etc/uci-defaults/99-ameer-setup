#!/bin/sh
. /etc/ameer/defaults.conf

uci set system.@system[0].hostname="$HOSTNAME"
uci set system.@system[0].timezone="$TIMEZONE"
uci commit system

[ -s /etc/config/wireless ] || wifi config
cp /etc/config/network  /etc/ameer/network.base
cp /etc/config/wireless /etc/ameer/wireless.base

uci -q set luci.main.mediaurlbase='/luci-static/material'
uci commit luci
[ -f /www/luci-static/material/cascade.css ] && cat /etc/ameer/theme.css >> /www/luci-static/material/cascade.css

uci -q delete lldpd.config
uci set lldpd.config=lldpd
uci set lldpd.config.enable_cdp='1'
uci set lldpd.config.enable_fdp='0'
uci set lldpd.config.enable_sonmp='0'
uci set lldpd.config.enable_edp='0'
uci set lldpd.config.lldp_description='AL-AMEER Phicomm K2'
uci set lldpd.config.interface='lan'
uci commit lldpd

cat > /etc/crontabs/root <<EOC
*/10 * * * * /usr/bin/ram-cleaner
* * * * * /usr/bin/ameer-watchdog
EOC
/etc/init.d/cron enable
/etc/init.d/lldpd enable 2>/dev/null

# خدمات غير ضرورية لجهاز أكسس بوينت (إقلاع أسرع)
for s in sysntpd odhcpd dnsmasq firewall; do [ -x /etc/init.d/$s ] && /etc/init.d/$s disable; done

NOREBOOT=1 /usr/bin/ameer-mode
exit 0
