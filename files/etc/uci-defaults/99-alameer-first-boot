#!/bin/sh
# ALAMEER SOFTWARE - safe first-boot finalization for the ImageBuilder overlay.
# The actual radio names are discovered by 99-alameer-config; never create stale
# default_radio0/default_radio1 sections which may not match this device profile.
LOG=/etc/alameer/first-boot.log
mkdir -p /etc/alameer
{
  echo "ALAMEER first boot: $(date '+%F %T')"
  LAN_IP="$(uci -q get network.lan.ipaddr)"
  if [ "$LAN_IP" != '192.168.1.20' ]; then
    echo "Fixing LAN IP from ${LAN_IP:-unset} to 192.168.1.20"
    uci set network.lan.proto='static'
    uci set network.lan.ipaddr='192.168.1.20'
    uci set network.lan.netmask='255.255.255.0'
    uci commit network
  fi
  uci set system.@system[0].hostname='Al-Makhadhi-K2'
  uci commit system

  # Default AP/bridge mode: merge the WAN VLAN device into br-lan and stop
  # the router from handing out addresses. Do not guess if the bridge is absent.
  WAN_DEV="$(cat /etc/alameer/wan_dev 2>/dev/null)"
  BRSEC=""
  for sec in $(uci show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=device$/\1/p'); do
    if [ "$(uci -q get network.${sec}.name)" = 'br-lan' ]; then BRSEC="$sec"; break; fi
  done
  if [ -n "$BRSEC" ] && [ -n "$WAN_DEV" ]; then
    uci -q del_list "network.${BRSEC}.ports=${WAN_DEV}"
    uci add_list "network.${BRSEC}.ports=${WAN_DEV}"
    uci -q delete network.wan
    uci -q delete network.wan6
    uci set dhcp.lan.ignore='1'
    uci commit network
    uci commit dhcp
    echo "AP bridge: added $WAN_DEV to br-lan; LAN DHCP disabled"
  else
    echo "AP bridge not changed: br-lan or WAN device not detected; keeping stock switch config"
  fi

  # Keep detected radio devices enabled; the regulatory database remains the
  # authority for which channels may actually transmit in the selected country.
  for radio in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    uci set "wireless.${radio}.disabled=0"
  done
  uci commit wireless
  echo "LAN: $(uci -q get network.lan.ipaddr)"
  echo "Country: $(uci -q get wireless.radio0.country 2>/dev/null || echo unset)"
  echo 'First-boot defaults finalized.'
} >> "$LOG" 2>&1
exit 0
