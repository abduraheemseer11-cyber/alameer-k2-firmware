#!/bin/sh
# ALAMEER SOFTWARE - first boot provisioning (runs once per fresh/reset flash, then self-deletes).
# Lives in the ROM, so a factory reset runs it again. Order of safety:
#   1. alameer-apply does everything atomically (nothing is changed if validation fails)
#   2. if it fails anyway, a minimal fallback still forces the required LAN IP + hostname
#   3. if Wi-Fi radios are not probed yet, alameer-boot finishes Wi-Fi at boot
LOG=/etc/alameer/first-boot.log
mkdir -p /etc/alameer
{ echo "first boot $(date '+%F %T')"; } > "$LOG"

IP="$(uci -q get alameer.core.lan_ip)";    IP="${IP:-192.168.1.20}"
MASK="$(uci -q get alameer.core.netmask)"; MASK="${MASK:-255.255.255.0}"
HN="$(uci -q get alameer.core.hostname)";  HN="${HN:-Al-Makhadhi-K2}"

uci -q batch <<UCI
set luci.main.mediaurlbase='/luci-static/alameer'
set luci.themes.ALAMEER='/luci-static/alameer'
commit luci
UCI

if /usr/sbin/alameer-apply ap --first-boot >>"$LOG" 2>&1; then
	echo "alameer-apply: OK" >> "$LOG"
else
	echo "alameer-apply: FAILED - reverting staged changes and using minimal fallback" >> "$LOG"
	uci -q revert network; uci -q revert wireless; uci -q revert dhcp; uci -q revert firewall
fi

# Guarantee the management address and hostname whatever happened above
if [ "$(uci -q get network.lan.ipaddr)" != "$IP" ] || [ "$(uci -q get network.lan.netmask)" != "$MASK" ]; then
	echo "fallback: forcing network.lan to $IP/$MASK" >> "$LOG"
	uci set network.lan.proto='static'
	uci set network.lan.ipaddr="$IP"
	uci set network.lan.netmask="$MASK"
	uci -q delete network.lan.ip6assign
	uci commit network
	uci set dhcp.lan.ignore='1'; uci commit dhcp
fi
uci set system.@system[0].hostname="$HN"; uci commit system
echo "final: lan=$(uci -q get network.lan.ipaddr)/$(uci -q get network.lan.netmask) hostname=$(uci -q get system.@system[0].hostname)" >> "$LOG"

/etc/init.d/alameer-boot enable 2>/dev/null

# lldpd: advertise hostname, CDP on, listen on the LAN bridge
if [ -x /usr/sbin/lldpd ]; then
	uci -q delete lldpd.config
	uci -q batch <<UCI
set lldpd.config=lldpd
set lldpd.config.enable_cdp='1'
set lldpd.config.enable_fdp='0'
set lldpd.config.enable_sonmp='0'
set lldpd.config.enable_edp='0'
set lldpd.config.lldp_class='10'
set lldpd.config.lldp_hostname='$HN'
set lldpd.config.lldp_description='ALAMEER SOFTWARE Phicomm K2 firmware'
set lldpd.config.interface='br-lan'
commit lldpd
UCI
fi
exit 0
