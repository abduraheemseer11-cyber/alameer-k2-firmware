#!/bin/sh
# Preserve the board-generated radio device sections; only update their AP interfaces.
uci -q set wireless.radio0.disabled='0'
uci -q set wireless.radio0.country='YE'
uci -q set wireless.radio0.channel='6'
uci -q set wireless.radio0.htmode='HT20'
uci -q set wireless.radio1.disabled='0'
uci -q set wireless.radio1.country='YE'
uci -q set wireless.radio1.channel='36'
uci -q set wireless.radio1.htmode='VHT40'

for section in $(uci -q show wireless | sed -n "s/^wireless\\.\\([^=]*\\)=wifi-iface$/\\1/p"); do
  device="$(uci -q get wireless.$section.device)"
  [ "$device" = radio0 ] && {
    uci -q set wireless.$section.mode='ap'
    uci -q set wireless.$section.ssid='AbduRaheem_2G'
    uci -q set wireless.$section.encryption='none'
    uci -q set wireless.$section.isolate='1'
  }
  [ "$device" = radio1 ] && {
    uci -q set wireless.$section.mode='ap'
    uci -q set wireless.$section.ssid='AbduRaheem_5G'
    uci -q set wireless.$section.encryption='none'
    uci -q set wireless.$section.isolate='1'
  }
done
uci -q commit wireless
exit 0
