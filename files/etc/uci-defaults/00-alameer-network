#!/bin/sh
uci -q batch <<'EOF'
set system.@system[0].hostname='Al-Makhadhi-K2'
set system.@system[0].zonename='Asia/Aden'
set system.@system[0].timezone='+03'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.20'
set network.lan.netmask='255.255.255.0'
delete network.wan
delete network.wan6
delete dhcp
commit system
commit network
EOF
exit 0
