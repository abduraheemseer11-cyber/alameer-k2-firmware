#!/bin/sh
# AlMakhdhi SoftWare AP profile for Phicomm K2 (PSG1218).
# Keeps ONLY 'lan' in Interfaces and bridges the physical WAN port into br-lan.
set -eu

/etc/init.d/alameer-loopguard enable || true
/etc/init.d/alameer-cpufreq enable || true

if [ "$(uci -q get alameer.main.initialized || echo 0)" = "1" ]; then
    exit 0
fi

# Delete WAN and WAN6 interfaces so ONLY 'lan' exists in Interfaces
uci -q delete network.wan || true
uci -q delete network.wan6 || true

# Merge physical WAN port into br-lan (DSA or swconfig compatible)
wan_ifname="$(uci -q get network.wan.device 2>/dev/null || uci -q get network.wan.ifname 2>/dev/null || true)"
uci -q show network | sed -n 's/^network\.\([^.=]*\)=device$/\1/p' | while IFS= read -r devsec; do
    [ "$(uci -q get "network.${devsec}.name" 2>/dev/null || true)" = "br-lan" ] || continue
    for p in wan eth0.2; do
        if [ -d "/sys/class/net/${p}" ] || [ "$wan_ifname" = "$p" ]; then
            uci -q del_list "network.${devsec}.ports=${p}" || true
            uci add_list "network.${devsec}.ports=${p}" || true
        fi
    done
done

# Configure switch VLAN 1 to include all 5 ports (WAN + 4 LAN) if swconfig is used
uci -q show network | sed -n 's/^network\.\([^.=]*\)=switch_vlan$/\1/p' | while IFS= read -r vsec; do
    vlan_num="$(uci -q get "network.${vsec}.vlan" 2>/dev/null || true)"
    if [ "$vlan_num" = "1" ]; then
        uci set "network.${vsec}.ports=0 1 2 3 4 6t" || true
    elif [ "$vlan_num" = "2" ]; then
        uci -q delete "network.${vsec}" || true
    fi
done

uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.20'
uci set network.lan.netmask='255.255.255.0'

if uci -q get dhcp.lan >/dev/null; then
    uci set dhcp.lan.ignore='1'
else
    uci set dhcp.lan='dhcp'
    uci set dhcp.lan.interface='lan'
    uci set dhcp.lan.ignore='1'
fi

uci set alameer.main.initialized='1'
uci commit network
uci commit dhcp
uci commit alameer
/usr/bin/alameer-reset-wireless
exit 0
