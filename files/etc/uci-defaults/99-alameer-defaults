#!/bin/sh
# ALAMEER SOFTWARE V3 first-boot defaults. Run once by OpenWrt uci-defaults.
set -eu

uci -q set system.@system[0].hostname='Al-Makhadhi-K2' || true

# Management LAN only. Keep the board's physical switch/VLAN definition intact.
uci -q set network.lan.proto='static'
uci -q set network.lan.ipaddr='192.168.1.20'
uci -q set network.lan.netmask='255.255.255.0'
uci -q delete network.wan || true
uci -q delete network.wan6 || true
uci -q set dhcp.lan.ignore='1'
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.ndp='disabled'

# Preserve the board's calibrated radio path; configure only standard UCI radio fields.
if uci -q get wireless.radio0 >/dev/null; then
    uci set wireless.radio0.disabled='0'
    uci set wireless.radio0.channel='6'
    uci set wireless.radio0.htmode='HT20'
    uci set wireless.radio0.txpower='30'
fi
if uci -q get wireless.radio1 >/dev/null; then
    uci set wireless.radio1.disabled='0'
    uci set wireless.radio1.channel='36'
    uci set wireless.radio1.htmode='HT40'
    uci set wireless.radio1.txpower='24'
fi

# Reuse the device-generated default interface sections, retaining radio calibration/device IDs.
if uci -q get wireless.default_radio0 >/dev/null; then
    uci set wireless.default_radio0.mode='ap'
    uci set wireless.default_radio0.network='lan'
    uci set wireless.default_radio0.ssid='AbduRaheem_2G'
    uci set wireless.default_radio0.encryption='none'
    uci set wireless.default_radio0.disabled='0'
fi
if uci -q get wireless.default_radio1 >/dev/null; then
    uci set wireless.default_radio1.mode='ap'
    uci set wireless.default_radio1.network='lan'
    uci set wireless.default_radio1.ssid='AbduRaheem_5G'
    uci set wireless.default_radio1.encryption='none'
    uci set wireless.default_radio1.disabled='0'
fi

uci commit system
uci commit network
uci commit dhcp
uci commit wireless

# Install the purple visual override into the active Bootstrap theme once.
mkdir -p /www/luci-static/alameer
if [ -f /www/luci-static/bootstrap/cascade.css ] && ! grep -q 'ALAMEER-V3-PURPLE' /www/luci-static/bootstrap/cascade.css; then
    printf '\n/* ALAMEER-V3-PURPLE */\n@import url("/luci-static/alameer/cascade.css?v=3");\n' >> /www/luci-static/bootstrap/cascade.css
fi
exit 0
