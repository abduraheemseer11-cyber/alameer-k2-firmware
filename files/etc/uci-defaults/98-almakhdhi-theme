#!/bin/sh
# Make the AlMakhdhi SoftWare theme the default LuCI theme (runs once, first boot).
# luci-theme-bootstrap stays installed as a fallback; to go back, run:
#   uci set luci.main.mediaurlbase='/luci-static/bootstrap' && uci commit luci

uci -q batch <<'UCI'
set luci.themes=internal
set luci.themes.AlMakhdhi='/luci-static/almakhdhi'
set luci.main.mediaurlbase='/luci-static/almakhdhi'
commit luci
UCI

exit 0
