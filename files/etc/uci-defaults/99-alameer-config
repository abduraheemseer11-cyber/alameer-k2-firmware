#!/bin/sh
# Alameer Software – first-boot defaults for Phicomm K2 v22.5 (OpenWrt 25.12).
# Runs once from /etc/uci-defaults, writes UCI only. It never restarts services:
# the normal boot sequence applies everything afterwards.

# ------------------------- edit these if needed -------------------------
LAN_IP="192.168.1.20"
LAN_MASK="255.255.255.0"
HOSTNAME="Alameer-K2"
SSID_2G="AbduRaheem_2G"
SSID_5G="AbduRaheem_5G"
WIFI_KEY="12345678"        # WPA2 password; leave empty for an open network
COUNTRY="BO"               # BO or US – observe your local regulations
TX_2G="20"                 # dBm (hardware/regdb will clamp if lower)
TX_5G="23"
SNMP_COMMUNITY="public"
# -------------------------------------------------------------------------

mkdir -p /etc/alameer

# ---- remember the physical WAN device (used by the Quick Setup wizard) ----
WAN_DEV="$(uci -q get network.wan.device)"
[ -n "$WAN_DEV" ] || WAN_DEV="eth0.2"
echo "$WAN_DEV" > /etc/alameer/wan_dev
echo "router" > /etc/alameer/mode

# ---- system identity ----
uci -q batch <<EOF
set system.@system[0].hostname='$HOSTNAME'
set system.@system[0].description='Alameer Software firmware'
set system.@system[0].notes='AbduRaheem Al-Maakhathi - WhatsApp 776538297'
commit system
EOF

# ---- LAN + no IPv6 (smaller, faster boot) ----
uci -q batch <<EOF
set network.lan.proto='static'
set network.lan.ipaddr='$LAN_IP'
set network.lan.netmask='$LAN_MASK'
delete network.lan.ip6assign
delete network.globals.ula_prefix
delete network.wan6
delete dhcp.lan.dhcpv6
delete dhcp.lan.ra
delete dhcp.lan.ra_slaac
delete dhcp.lan.ra_flags
commit network
commit dhcp
EOF

# ---- uhttpd: plain HTTP only ----
uci -q batch <<EOF
delete uhttpd.main.listen_https
delete uhttpd.main.listen_http
add_list uhttpd.main.listen_http='0.0.0.0:80'
delete uhttpd.main.cert
delete uhttpd.main.key
set uhttpd.main.redirect_https='0'
delete uhttpd.px5g
commit uhttpd
EOF

# ---- LuCI theme ----
uci -q get luci.themes >/dev/null || uci set luci.themes='internal'
uci -q batch <<EOF
set luci.themes.Alameer='/luci-static/alameer'
set luci.main.mediaurlbase='/luci-static/alameer'
commit luci
EOF

# ---- Wi-Fi ----
# Make sure /etc/config/wireless exists (generated by wifi detect on first boot)
if ! uci -q get wireless.@wifi-device[0] >/dev/null; then
	/sbin/wifi config >/dev/null 2>&1
fi

radio_band() {
	local b
	b="$(uci -q get wireless.$1.band)"
	case "$b" in 2g|5g|6g) echo "$b"; return;; esac
	case "$(uci -q get wireless.$1.hwmode)" in 11g) echo 2g; return;; 11a) echo 5g; return;; esac
	case "$(uci -q get wireless.$1.channel)" in [1-9]|1[0-4]) echo 2g;; *) echo 5g;; esac
}

# remove default (anonymous / default_radioN) AP sections and recreate ours
while uci -q delete wireless.@wifi-iface[0]; do :; done

for r in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	band="$(radio_band "$r")"
	uci -q delete wireless.$r.disabled
	uci set wireless.$r.country="$COUNTRY"
	uci set wireless.$r.channel='auto'
	case "$band" in
	2g) uci set wireless.$r.htmode='HT40'; uci set wireless.$r.txpower="$TX_2G"; SSID="$SSID_2G";;
	5g) uci set wireless.$r.htmode='VHT80'; uci set wireless.$r.txpower="$TX_5G"; SSID="$SSID_5G";;
	*) continue;;
	esac
	s="ap_$band"
	uci set wireless.$s='wifi-iface'
	uci set wireless.$s.device="$r"
	uci set wireless.$s.mode='ap'
	uci set wireless.$s.network='lan'
	uci set wireless.$s.ssid="$SSID"
	if [ -n "$WIFI_KEY" ]; then
		uci set wireless.$s.encryption='psk2'
		uci set wireless.$s.key="$WIFI_KEY"
	else
		uci set wireless.$s.encryption='none'
	fi
done
uci commit wireless

# ---- SNMP (MikroTik The Dude) ----
cat > /etc/config/mini_snmpd <<EOF
config mini_snmpd 'default'
	option enabled '1'
	option ipv6 '0'
	option community '$SNMP_COMMUNITY'
	option contact 'AbduRaheem Al-Maakhathi 776538297'
	option location 'Alameer Software'
	option description 'Alameer-K2 (Phicomm K2 v22.5)'
	option interfaces 'br-lan'
	option disks '/overlay'
EOF
/etc/init.d/mini_snmpd enable 2>/dev/null

# Allow SNMP polling from the uplink side (WISP monitoring). Remove if not wanted.
uci -q delete firewall.alameer_snmp
uci -q batch <<EOF
set firewall.alameer_snmp='rule'
set firewall.alameer_snmp.name='Allow-SNMP-WAN'
set firewall.alameer_snmp.src='wan'
set firewall.alameer_snmp.proto='udp'
set firewall.alameer_snmp.dest_port='161'
set firewall.alameer_snmp.target='ACCEPT'
commit firewall
EOF

exit 0
