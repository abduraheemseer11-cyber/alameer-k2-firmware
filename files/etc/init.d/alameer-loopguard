#!/bin/sh /etc/rc.common
# Started early so broadcast storms are caught right after boot.
START=21
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/alameer-loopguard
	procd_set_param respawn
	procd_close_instance
}
service_triggers() { procd_add_reload_trigger alameer; }
