#!/bin/sh /etc/rc.common
START=30
USE_PROCD=1
start_service() {
	[ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ] || return 0
	if [ "$(uci -q get alameer.cpu.mode)" = auto ]; then
		procd_open_instance
		procd_set_param command /usr/sbin/alameer-cpufreq
		procd_set_param respawn
		procd_close_instance
	else
		/usr/sbin/alameer-cpufreq
	fi
}
service_triggers() { procd_add_reload_trigger alameer; }
