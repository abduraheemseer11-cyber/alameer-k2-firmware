config core 'core'
	option version '22.5'
	option mode 'ap'
	option hostname 'Al-Makhadhi-K2'
	option lan_ip '192.168.1.20'
	option netmask '255.255.255.0'
	option gateway ''
	option dns ''
	option country 'US'

config wifi 'wifi_2g'
	option ssid 'AbduRaheem_2G'
	option encryption 'none'
	option key ''

config wifi 'wifi_5g'
	option ssid 'AbduRaheem_5G'
