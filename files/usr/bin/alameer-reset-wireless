#!/bin/sh
# Auto-detect 2.4GHz and 5GHz radios on Phicomm K2 and configure AC (VHT80) + 20dBm.
set -eu

RADIO_2G=""
RADIO_5G=""

for radio in radio0 radio1; do
    uci -q get "wireless.${radio}" >/dev/null || continue
    band="$(uci -q get "wireless.${radio}.band" 2>/dev/null || true)"
    hwmode="$(uci -q get "wireless.${radio}.hwmode" 2>/dev/null || true)"
    channel="$(uci -q get "wireless.${radio}.channel" 2>/dev/null || true)"

    if [ "$band" = "5g" ] || [ "$hwmode" = "11a" ] || [ "${channel:-0}" -gt 14 ] 2>/dev/null; then
        RADIO_5G="$radio"
    else
        RADIO_2G="$radio"
    fi
done

[ -n "$RADIO_2G" ] || RADIO_2G="radio0"
[ -n "$RADIO_5G" ] || RADIO_5G="radio1"

# Delete every wifi-iface assigned to either physical radio
uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p' | while IFS= read -r section; do
    [ -n "$section" ] || continue
    device="$(uci -q get "wireless.${section}.device" 2>/dev/null || true)"
    case "$device" in
        radio0|radio1) uci -q delete "wireless.${section}" ;;
    esac
done

uci set "wireless.${RADIO_2G}.disabled=0"
uci set "wireless.${RADIO_5G}.disabled=0"

uci set wireless.alameer_2g='wifi-iface'
uci set "wireless.alameer_2g.device=${RADIO_2G}"
uci set wireless.alameer_2g.mode='ap'
uci set wireless.alameer_2g.network='lan'
uci set wireless.alameer_2g.ssid='AbduRaheem_2G'
uci set wireless.alameer_2g.encryption='none'

uci set wireless.alameer_5g='wifi-iface'
uci set "wireless.alameer_5g.device=${RADIO_5G}"
uci set wireless.alameer_5g.mode='ap'
uci set wireless.alameer_5g.network='lan'
uci set wireless.alameer_5g.ssid='AbduRaheem_5G'
uci set wireless.alameer_5g.encryption='none'

# 2.4GHz: 20dBm
uci set "wireless.${RADIO_2G}.channel=6"
uci set "wireless.${RADIO_2G}.htmode=HT20"
uci set "wireless.${RADIO_2G}.txpower=20"

# 5GHz: 802.11ac (VHT80) & 20dBm
uci set "wireless.${RADIO_5G}.channel=36"
uci set "wireless.${RADIO_5G}.hwmode=11a"
uci set "wireless.${RADIO_5G}.htmode=VHT80"
uci set "wireless.${RADIO_5G}.txpower=20"

uci commit wireless
wifi reload >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1 || true
