#!/bin/sh
# Removes every wifi-iface and creates the two standard Alameer networks.
KEY="$(uci -q get alameer.main.wifi_key)"; [ -z "$KEY" ] && KEY='ChangeMe1234'
CC="$(uci -q get alameer.main.country)";   [ -z "$CC" ] && CC='US'
[ -e /etc/config/wireless ] || wifi config
while uci -q delete wireless.@wifi-iface[0]; do :; done

setradio() { # radio channel htmode band
	uci -q get wireless.$1 >/dev/null || return 0
	uci set wireless.$1.disabled='0'
	uci set wireless.$1.country="$CC"
	uci set wireless.$1.txpower='20'
	uci set wireless.$1.channel="$2"
	uci set wireless.$1.htmode="$3"
	[ -n "$4" ] && uci set wireless.$1.band="$4"
}
addiface() { # name radio ssid
	uci -q get wireless.$2 >/dev/null || return 0
	uci set wireless.$1=wifi-iface
	uci set wireless.$1.device="$2"
	uci set wireless.$1.network='lan'
	uci set wireless.$1.mode='ap'
	uci set wireless.$1.ssid="$3"
	uci set wireless.$1.encryption='psk2'
	uci set wireless.$1.key="$KEY"
}
setradio radio0 6  HT20  2g
setradio radio1 36 VHT80 5g
addiface alameer_2g radio0 AbduRaheem_2G
addiface alameer_5g radio1 AbduRaheem_5G
uci commit wireless
wifi reload 2>/dev/null
exit 0
