{
	"luci-app-alameer": {
		"description": "Grant access to the Alameer Quick Setup wizard",
		"read": {
			"ubus": {
				"iwinfo": [ "devices", "info", "scan", "freqlist" ],
				"network.wireless": [ "status" ],
				"system": [ "board" ]
			},
			"uci": [ "system", "network", "wireless", "dhcp", "firewall" ],
			"file": {
				"/etc/alameer/mode": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"luci": [ "setPassword" ]
			},
			"file": {
				"/tmp/alameer-qs.json": [ "write" ],
				"/usr/libexec/alameer/quicksetup-apply": [ "exec" ]
			}
		}
	}
}
