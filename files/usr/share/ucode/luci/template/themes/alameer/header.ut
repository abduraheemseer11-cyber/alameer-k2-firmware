{#
	Alameer Software LuCI theme – header (OpenWrt 25.12 ucode template).
	Sidebar + fixed purple top bar. Menu is rendered by menu-alameer.js.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');

	http.prepare_content('text/html; charset=UTF-8');
%}

<!DOCTYPE html>
<html lang="en" data-darkmode="false">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
		<meta name="theme-color" content="#3b0d54">
		<meta name="color-scheme" content="light">
		<title>{{ boardinfo.hostname ?? '?' }}{{ node?.title ? ' - ' + node.title : '' }} - Alameer Software</title>
		<link rel="stylesheet" href="{{ media }}/cascade.css">
		<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
	</head>

	<body class="lg am-theme" data-page="{{ join('-', ctx.path) }}">
		<div id="amtop">
			<button id="amtoggle" type="button" aria-label="Menu"><i></i><i></i><i></i></button>
			<a class="ambrand" href="/cgi-bin/luci/">
				<span class="amlogo"><img src="{{ media }}/logo.svg" alt="" width="40" height="40"></span>
				<b>Alameer Software</b>
			</a>
			<span class="amhost">{{ boardinfo.hostname ?? '' }}</span>
			<div id="indicators"></div>
		</div>

		<nav id="amside"><ul id="mainmenu"></ul></nav>
		<div id="amscrim"></div>

		<div id="maincontent" class="am-main">
			<div id="tabmenu" style="display:none"></div>
			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
			<div class="alert-message warning">
				<h4>{{ _('No password set!') }}</h4>
				<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
				<div class="right"><a class="btn" href="/cgi-bin/luci/admin/system/admin">{{ _('Go to password configuration...') }}</a></div>
			</div>
			{% endif %}
