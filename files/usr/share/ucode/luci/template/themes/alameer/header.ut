{# ALAMEER SOFTWARE - OpenWrt 24.10/25.12 ucode LuCI theme header. #}
{%
	import { getuid, getspnam } from 'luci.core';
	const boardinfo = ubus.call('system', 'board') ?? {};
	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="theme-color" content="#101116">
	<meta name="color-scheme" content="dark light">
	<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ' | ' + _(dispatched.title) : ''} | ALAMEER SOFTWARE`) }}</title>
	<link rel="stylesheet" href="{{ media }}/cascade.css">
	<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
	{% if (dispatched?.css): %}<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">{% endif %}
	{% if (css): %}<style>{{ css }}</style>{% endif %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
	<script src="{{ resource }}/cbi.js"></script>
</head>
<body class="am-theme" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
	<a class="am-skip" href="#maincontent">{{ _('Skip to content') }}</a>
	<header id="amtop">
		<button id="amtoggle" type="button" aria-label="{{ _('Toggle navigation') }}" aria-expanded="false"><span></span><span></span><span></span></button>
		<a class="ambrand" href="{{ dispatcher.build_url('admin/status/overview') }}">
			<img src="{{ media }}/logo.png" alt="ALAMEER" width="42" height="42">
			<span><b>ALAMEER SOFTWARE</b><small>PROFESSIONAL FIRMWARE</small></span>
		</a>
		<div class="am-top-spacer"></div>
		<div class="am-top-meta"><span class="am-live-dot"></span><span>{{ striptags(boardinfo.hostname ?? 'Al-Makhadhi-K2') }}</span></div>
		<div id="indicators"></div>
	</header>
	<aside id="amside" aria-label="{{ _('Main navigation') }}">
		<div class="am-side-caption">{{ _('MAIN MENU') }}</div>
		<ul id="mainmenu"></ul>
		<div class="am-side-bottom">
			<div class="am-side-device"><span class="am-device-icon">K2</span><span><b>Phicomm K2</b><small>V22.5 · 8 MB Flash</small></span></div>
			<div class="am-credit">ALAMEER SOFTWARE<br>Eng. Abdulrahim Al-Makhadhi</div>
		</div>
	</aside>
	<div id="amscrim"></div>
	<main id="maincontent" class="am-main">
		<div id="tabmenu" style="display:none"></div>
		<noscript><div class="alert-message warning"><h4>{{ _('JavaScript required') }}</h4><p>{{ _('Enable JavaScript to use the LuCI interface.') }}</p></div></noscript>
		<div class="am-page-heading">
			<div><span class="am-eyebrow">ALAMEER CONTROL CENTER</span><h1>{{ dispatched?.title ? _(dispatched.title) : _('Router Management') }}</h1></div>
			<div class="am-page-host">{{ striptags(boardinfo.hostname ?? 'Al-Makhadhi-K2') }}</div>
		</div>
		{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
		<div class="alert-message warning"><h4>{{ _('No password set!') }}</h4><p>{{ _('Set a root password to protect the web interface.') }}</p><div class="right"><a class="btn" href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Configure password') }}</a></div></div>
		{% endif %}
		{% if (boardinfo.rootfs_type == 'initramfs'): %}
		<div class="alert-message warning"><h4>{{ _('Recovery mode') }}</h4><p>{{ _('Changes may not persist after reboot.') }}</p></div>
		{% endif %}
